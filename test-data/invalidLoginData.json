{
  "emptyUsername": {
    "accessCode": "axv51",
    "username": "",
    "expectedError": "Username is required"
  },
  "emptyAccessCode": {
    "accessCode": "",
    "username": "Admin@assetanalytix.com",
    "expectedError": "Access code is required"
  },
  "bothEmpty": {
    "accessCode": "",
    "username": "",
    "expectedError": "Username and access code are required"
  },
  "invalidEmailFormat": {
    "accessCode": "axv51",
    "username": "invalid-email-format",
    "expectedError": "Invalid email format"
  },
  "wrongAccessCode": {
    "accessCode": "wrong123",
    "username": "Admin@assetanalytix.com",
    "expectedError": "Invalid access code"
  },
  "wrongUsername": {
    "accessCode": "axv51",
    "username": "wrong@example.com",
    "expectedError": "Invalid credentials"
  },
  "sqlInjection": {
    "accessCode": "axv51'; DROP TABLE users--",
    "username": "Admin@assetanalytix.com",
    "expectedError": "Invalid access code"
  },
  "xssAttempt": {
    "accessCode": "<script>alert('xss')</script>",
    "username": "Admin@assetanalytix.com",
    "expectedError": "Invalid access code"
  },
  "specialCharactersUsername": {
    "accessCode": "axv51",
    "username": "Admin@<script>.com",
    "expectedError": "Invalid email format"
  },
  "nullValues": {
    "accessCode": null,
    "username": null,
    "expectedError": "Invalid input"
  },
  "spacesOnly": {
    "accessCode": "   ",
    "username": "   ",
    "expectedError": "Username and access code are required"
  },
  "tooLongAccessCode": {
    "accessCode": "abcdefghijklmnopqrstuvwxyz1234567890abcdefghijklmnopqrstuvwxyz",
    "username": "Admin@assetanalytix.com",
    "expectedError": "Access code too long"
  }
}
